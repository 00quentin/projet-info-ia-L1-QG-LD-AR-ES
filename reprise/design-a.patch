+  { cle: "actions", libelle: "Actions", couleur: "var(--series-1)", motifs: ["action", "indice", "sector", "themat"] },
+  { cle: "obligations", libelle: "Obligations", couleur: "var(--series-3)", motifs: ["oblig"] },
